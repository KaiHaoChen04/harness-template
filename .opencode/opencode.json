{
    "$schema": "https://opencode.ai/config.json",
    "agent": {
        "build": {
            "mode": "primary",
            "model": "openai/gpt-5.6-sol",
            "prompt": "Build according to @plan",
            "permission": {
                "edit": "allow",
                "bash": "allow"
            },
            "temperature": 0.1
        },
        "plan":{
            "mode": "primary",
            "prompt": "Plan according to user's prompt and delegate to build agent",
            "permission": {
                "edit": "deny",
                "bash": "allow"
            },
            "temperature": 0.5
        },
        "git-reviewer": {
            "mode": "subagent",
            "prompt": "Check files individually and commit them individually with their corresponding changes in the commit message.",
            "permission": {
                "bash": {
                    "*": "ask",
                    "git *": "allow"      
                }
            }
        }
    }
}
